{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "perf": "warn",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "rules": {
    "no-unused-vars": "error",
    "no-console": "warn",
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "no-await-in-loop": "off"
  },
  "plugins": ["typescript", "import", "promise", "unicorn"],
  "ignorePatterns": ["node_modules", "**/dist", "build", "coverage", "*.d.ts"],
  "env": {
    "node": true,
    "es2022": true
  },
  "overrides": [
    {
      "files": ["src/cli.ts", "src/**/*.test.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["src/**/*.ts"],
      "rules": {
        "import/no-default-export": "error"
      }
    }
  ]
}
